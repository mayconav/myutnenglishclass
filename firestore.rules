rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // El profesor se identifica por su correo (mismo valor que ADMIN_EMAIL en js/firebase-config.js).
    function isTeacher() {
      return signedIn() && request.auth.token.email == "maap044@gmail.com";
    }

    match /students/{studentId} {

      // Un estudiante puede crear UNICAMENTE su propio documento al registrarse:
      //  - sin grupo (solo el profesor asigna el grupo),
      //  - activo (disabled == false),
      //  - y solo con los campos que escribe el registro.
      allow create: if signedIn()
                    && request.auth.uid == studentId
                    && request.resource.data.disabled == false
                    && request.resource.data.grupo == ""
                    && request.resource.data.keys().hasOnly(
                         ['nombre', 'correo', 'boleta', 'grupo', 'disabled',
                          'createdAt', 'updatedAt', 'progress']);

      // Un estudiante lee su propio documento; el profesor lee cualquiera.
      allow read: if signedIn()
                  && (request.auth.uid == studentId || isTeacher());

      // El profesor puede actualizar cualquier campo (grupo, disabled, nombre...).
      // Un estudiante SOLO puede escribir su progreso y la marca de tiempo:
      // no puede cambiar grupo, disabled, nombre, boleta ni correo.
      allow update: if isTeacher()
                    || (signedIn()
                        && request.auth.uid == studentId
                        && resource.data.disabled == false
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['progress', 'updatedAt'])
                        && request.resource.data.progress is map);

      // Solo el profesor puede eliminar registros de estudiantes.
      allow delete: if isTeacher();
    }

    // ============ BINGO EN VIVO (controlado por el profesor) ============
    match /bingoSessions/{sessionId} {

      // Cualquier persona autenticada puede leer el estado de la sala.
      allow read: if signedIn();

      // Solo el profesor controla la sala.
      allow write: if isTeacher();

      // Jugadores conectados a la sala (un documento por alumno).
      match /players/{studentId} {

        allow read: if signedIn();

        // Un alumno solo escribe SU documento de jugador, y solo si su grupo
        // (el de su registro en /students) es el grupo de la sala. Al unirse,
        // la sala no debe estar cerrada.
        allow create: if signedIn()
                      && request.auth.uid == studentId
                      && request.resource.data.grupo ==
                           get(/databases/$(database)/documents/bingoSessions/$(sessionId)).data.grupo
                      && request.resource.data.grupo ==
                           get(/databases/$(database)/documents/students/$(request.auth.uid)).data.grupo
                      && get(/databases/$(database)/documents/bingoSessions/$(sessionId)).data.status != "ended";

        allow update: if signedIn()
                      && request.auth.uid == studentId
                      && request.resource.data.grupo ==
                           get(/databases/$(database)/documents/bingoSessions/$(sessionId)).data.grupo
                      && request.resource.data.grupo ==
                           get(/databases/$(database)/documents/students/$(request.auth.uid)).data.grupo;

        // Un alumno puede salir por su cuenta; el profesor puede remover a cualquiera.
        allow delete: if signedIn()
                      && (request.auth.uid == studentId || isTeacher());
      }
    }
  }
}
